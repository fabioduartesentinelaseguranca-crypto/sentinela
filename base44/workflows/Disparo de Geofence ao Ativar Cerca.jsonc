{
  "name": "Disparo de Geofence ao Ativar Cerca",
  "description": "Quando uma cerca geogr\u00e1fica tiver seu status alterado para ativo, verifica todos os usu\u00e1rios com localiza\u00e7\u00e3o e dispara notifica\u00e7\u00f5es push para quem estiver dentro do pol\u00edgono.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"ativo\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Cercas_Geograficas_Defesa_Civil"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "disparo_de_geofence_ao_ativar_cerca",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispararGeofenceUsuarios",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dispararGeofenceUsuarios"
  }
}