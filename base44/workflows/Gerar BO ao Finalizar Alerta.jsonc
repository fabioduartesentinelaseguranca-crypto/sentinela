{
  "name": "Gerar BO ao Finalizar Alerta",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.status_alerta == \"FINALIZADO\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Alertas_Inteligencia_IA"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gerar_bo_ao_finalizar_alerta",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "gerarBoletimOcorrencia",
            "args": {
              "alerta_id": "{{data.id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "gerarBoletimOcorrencia"
  }
}