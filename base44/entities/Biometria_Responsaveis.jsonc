{
  "name": "Biometria_Responsaveis",
  "type": "object",
  "properties": {
    "nome_responsavel": {
      "type": "string",
      "description": "Nome completo do respons\u00e1vel"
    },
    "parentesco": {
      "type": "string",
      "enum": [
        "pai",
        "mae",
        "avo",
        "avoa",
        "tio",
        "tia",
        "responsavel_legal",
        "outro"
      ],
      "default": "responsavel_legal"
    },
    "telefone": {
      "type": "string"
    },
    "id_escola_cerca": {
      "type": "string",
      "description": "ID da escola vinculada (associa\u00e7\u00e3o prim\u00e1ria)"
    },
    "nome_escola": {
      "type": "string"
    },
    "matriculas_vinculadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Matr\u00edculas dos alunos que este respons\u00e1vel pode retirar"
    },
    "alunos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos registros Alunos_Biometria vinculados"
    },
    "alunos_nomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto biom\u00e9trica do respons\u00e1vel"
    },
    "face_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vetor biom\u00e9trico facial do respons\u00e1vel (128 dimens\u00f5es)"
    },
    "score_qualidade": {
      "type": "number",
      "description": "Score de qualidade da foto (0-100)"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "cadastrado_por_id": {
      "type": "string"
    },
    "cadastrado_por_nome": {
      "type": "string"
    }
  },
  "required": [
    "nome_responsavel",
    "id_escola_cerca"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}