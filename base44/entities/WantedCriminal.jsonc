{
  "name": "WantedCriminal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo ou apelido"
    },
    "alias": {
      "type": "string",
      "description": "Alcunha / apelido"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto ou retrato falado"
    },
    "face_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vetor biom\u00e9trico facial (128 dims) \u2014 gerado via IA no cadastro"
    },
    "description": {
      "type": "string",
      "description": "Caracter\u00edsticas f\u00edsicas e crimes"
    },
    "crimes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Crimes cometidos"
    },
    "reward": {
      "type": "number",
      "default": 0,
      "description": "Valor da recompensa em R$"
    },
    "status": {
      "type": "string",
      "enum": [
        "wanted",
        "captured",
        "inactive"
      ],
      "default": "wanted"
    },
    "danger_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "extreme"
      ],
      "default": "medium"
    },
    "last_seen_location": {
      "type": "string"
    },
    "last_seen_date": {
      "type": "string",
      "format": "date"
    },
    "warrant_number": {
      "type": "string",
      "description": "N\u00famero do mandado"
    },
    "age_approx": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "threshold_alerta": {
      "type": "number",
      "default": 80,
      "description": "Threshold de confian\u00e7a (%) para disparar alerta \u2014 ajust\u00e1vel por perfil de risco"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}