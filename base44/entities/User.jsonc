{
  "name": "User",
  "type": "object",
  "properties": {
    "cpf": {
      "type": "string",
      "description": "CPF do usu\u00e1rio"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do usu\u00e1rio"
    },
    "role": {
      "type": "string",
      "enum": [
        "citizen",
        "agent",
        "admin"
      ],
      "default": "citizen",
      "description": "Perfil: Cidad\u00e3o, Agente, Admin"
    },
    "protective_measure_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "active",
        "inactive"
      ],
      "default": "none",
      "description": "Status da medida protetiva"
    },
    "protective_measure_doc_url": {
      "type": "string",
      "description": "URL do documento de medida protetiva"
    },
    "agent_badge": {
      "type": "string",
      "description": "Matr\u00edcula/Identifica\u00e7\u00e3o do agente"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos de gamifica\u00e7\u00e3o"
    },
    "last_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  },
  "required": []
}