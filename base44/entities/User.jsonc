{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "citizen",
        "agent",
        "admin",
        "psychologist"
      ],
      "default": "citizen",
      "description": "Perfil do usu\u00e1rio na plataforma"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados por reportes confirmados"
    },
    "agent_badge": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o do agente (matr\u00edcula / prefixo)"
    },
    "protective_measure_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "active",
        "inactive"
      ],
      "default": "none",
      "description": "Status da medida protetiva"
    },
    "protective_measure_doc_url": {
      "type": "string",
      "description": "URL do documento de medida protetiva enviado"
    },
    "disarm_pin": {
      "type": "string",
      "description": "PIN de 4 d\u00edgitos para desarmar a calculadora disfar\u00e7ada"
    },
    "coercion_pin": {
      "type": "string",
      "description": "PIN de coa\u00e7\u00e3o de 4 d\u00edgitos \u2014 ao digit\u00e1-lo, a calculadora finge desarmar mas envia alerta silencioso de c\u00f3digo vermelho"
    },
    "last_location": {
      "type": "object",
      "description": "\u00daltima localiza\u00e7\u00e3o registrada",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do ClienteMunicipal ao qual este usu\u00e1rio pertence"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do munic\u00edpio/cliente (desnormalizado para exibi\u00e7\u00e3o r\u00e1pida)"
    }
  },
  "required": []
}