{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "citizen",
        "agent",
        "admin"
      ],
      "default": "citizen",
      "description": "Perfil do usu\u00e1rio na plataforma"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados por reportes de Defesa Civil confirmados"
    },
    "agent_badge": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o do agente (matr\u00edcula / prefixo)"
    },
    "protective_measure_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "active",
        "inactive"
      ],
      "default": "none",
      "description": "Status da medida protetiva"
    },
    "protective_measure_doc_url": {
      "type": "string",
      "description": "URL do documento de medida protetiva enviado"
    },
    "last_location": {
      "type": "object",
      "description": "\u00daltima localiza\u00e7\u00e3o registrada (agentes e modo disfar\u00e7ado)",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  }
}