{
  "name": "Logs_Auditoria_QA",
  "type": "object",
  "properties": {
    "execucao_id": {
      "type": "string",
      "description": "ID \u00fanico da execu\u00e7\u00e3o de QA"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "geracao_dados",
        "criacao_ocorrencias",
        "triagem_ia",
        "atribuicao_agente",
        "progressao_status",
        "finalizacao",
        "health_check"
      ],
      "description": "Etapa do fluxo sendo auditada"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "timeout",
        "skipped"
      ],
      "default": "success"
    },
    "tempo_ms": {
      "type": "number",
      "description": "Tempo de resposta da etapa em milissegundos"
    },
    "ocorrencia_id": {
      "type": "string",
      "description": "ID da ocorr\u00eancia testada (se aplic\u00e1vel)"
    },
    "agente_id": {
      "type": "string",
      "description": "ID do agente envolvido (se aplic\u00e1vel)"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro capturada"
    },
    "error_details": {
      "type": "string",
      "description": "Detalhes t\u00e9cnicos do erro (stack trace, payload)"
    },
    "detalhe": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o leg\u00edvel do que foi testado"
    },
    "data_execucao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "execucao_id",
    "etapa",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}