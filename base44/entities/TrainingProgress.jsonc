{
  "name": "TrainingProgress",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "module_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "watching",
        "quiz",
        "passed",
        "failed"
      ],
      "default": "not_started"
    },
    "score": {
      "type": "number",
      "description": "% obtida no quiz"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_task": {
      "type": "string",
      "description": "Resposta/exerc\u00edcio submetido pelo agente"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "revision"
      ],
      "default": "pending",
      "description": "Status da revis\u00e3o do admin"
    },
    "review_feedback": {
      "type": "string",
      "description": "Feedback do administrador"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_id",
    "module_id"
  ]
}