{
  "name": "Sessoes_CaminheComigo",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do cidad\u00e3o que iniciou a sess\u00e3o"
    },
    "user_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "share_token": {
      "type": "string",
      "description": "Token \u00fanico para link de compartilhamento"
    },
    "origem_lat": {
      "type": "number"
    },
    "origem_lng": {
      "type": "number"
    },
    "destino_lat": {
      "type": "number"
    },
    "destino_lng": {
      "type": "number"
    },
    "destino_nome": {
      "type": "string",
      "description": "Nome do destino (ex: Casa, Trabalho)"
    },
    "contato_notificado": {
      "type": "string",
      "description": "Nome do contato de emerg\u00eancia notificado"
    },
    "contato_telefone": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "share_token"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}