{
  "name": "Camera",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome/identificador da c\u00e2mera"
    },
    "type": {
      "type": "string",
      "enum": [
        "fixed",
        "dome",
        "ptz"
      ],
      "default": "fixed",
      "description": "Tipo da c\u00e2mera"
    },
    "lat": {
      "type": "number",
      "description": "Latitude (GPS da c\u00e2mera para despacho geolocalizado)"
    },
    "lng": {
      "type": "number",
      "description": "Longitude (GPS da c\u00e2mera para despacho geolocalizado)"
    },
    "zone": {
      "type": "string",
      "description": "Zona/setor da c\u00e2mera (ex: Port\u00e3o Principal, Beco dos Fundos)"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o da c\u00e2mera"
    },
    "stream_url": {
      "type": "string",
      "description": "URL do stream externo (HLS/WebRTC fornecida pela prefeitura)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "C\u00e2mera ativa"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name",
    "lat",
    "lng"
  ]
}