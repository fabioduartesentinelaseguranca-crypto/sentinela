{
  "name": "Wanted_Persons",
  "type": "object",
  "properties": {
    "alias": {
      "type": "string",
      "description": "Nome ou apelido do indiv\u00edduo procurado"
    },
    "photo_url": {
      "type": "string"
    },
    "face_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vetor biom\u00e9trico facial (128 dims)"
    },
    "threat_level": {
      "type": "string",
      "enum": [
        "high",
        "medium"
      ],
      "default": "high"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "alias"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}