{
  "name": "Alertas_Quarentena",
  "type": "object",
  "properties": {
    "ocorrencia_id": {
      "type": "string",
      "description": "ID da ocorr\u00eancia suspeita"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que reportou"
    },
    "user_name": {
      "type": "string"
    },
    "motivo_suspeita": {
      "type": "string",
      "description": "Raz\u00e3o da detec\u00e7\u00e3o de poss\u00edvel trote"
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de evid\u00eancias detectadas pela IA"
    },
    "score_suspeita": {
      "type": "number",
      "description": "Score de 0 a 100 da probabilidade de trote",
      "minimum": 0,
      "maximum": 100
    },
    "fatores_analisados": {
      "type": "object",
      "properties": {
        "discrepancia_gps": {
          "type": "boolean"
        },
        "multiplos_relatos_simultaneos": {
          "type": "boolean"
        },
        "historico_suspeito": {
          "type": "boolean"
        },
        "ip_dispositivo_inconsistente": {
          "type": "boolean"
        },
        "descricao_vaga": {
          "type": "boolean"
        }
      },
      "description": "Checklist de fatores detectados"
    },
    "status_validacao": {
      "type": "string",
      "enum": [
        "pendente",
        "em_analise",
        "confirmado_trote",
        "falso_positivo"
      ],
      "default": "pendente"
    },
    "revisado_por_id": {
      "type": "string",
      "description": "ID do admin/agente que revisou"
    },
    "revisado_por_nome": {
      "type": "string"
    },
    "data_revisao": {
      "type": "string",
      "format": "date-time"
    },
    "observacoes_revisao": {
      "type": "string"
    }
  },
  "required": [
    "ocorrencia_id",
    "user_id",
    "motivo_suspeita"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}