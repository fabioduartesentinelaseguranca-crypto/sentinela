{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "description": "Tipo de evento"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    }
  },
  "required": [
    "event"
  ]
}