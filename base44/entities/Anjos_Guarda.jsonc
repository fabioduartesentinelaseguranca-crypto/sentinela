{
  "name": "Anjos_Guarda",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio volunt\u00e1rio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome completo do volunt\u00e1rio"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro(s) de atua\u00e7\u00e3o"
    },
    "cidade": {
      "type": "string"
    },
    "lat": {
      "type": "number",
      "description": "Latitude da resid\u00eancia/base"
    },
    "lng": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "suspenso",
        "inativo"
      ],
      "default": "pendente"
    },
    "certificacoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Certifica\u00e7\u00f5es: primeiros socorros, brigadista, etc."
    },
    "disponibilidade": {
      "type": "string",
      "enum": [
        "disponivel",
        "indisponivel",
        "dormindo"
      ],
      "default": "disponivel"
    },
    "total_atendimentos": {
      "type": "number",
      "default": 0
    },
    "avaliacao_media": {
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 5
    },
    "observacoes": {
      "type": "string"
    },
    "aprovado_por_id": {
      "type": "string"
    },
    "aprovado_por_nome": {
      "type": "string"
    },
    "data_cadastro": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "bairro"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "citizen"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "aprovado"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}",
          "data.status": "pendente"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}