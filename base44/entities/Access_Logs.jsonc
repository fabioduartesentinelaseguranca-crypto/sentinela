{
  "name": "Access_Logs",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_url": {
      "type": "string",
      "description": "URL do snapshot/crop do rosto capturado"
    },
    "classification": {
      "type": "string",
      "enum": [
        "Allowed Student",
        "Student Evasion Attempt",
        "Unauthorized Intruder",
        "Wanted Suspect",
        "Ambiguous"
      ]
    },
    "action_taken": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "similarity": {
      "type": "number"
    },
    "camera_id": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "enum": [
        "escolar",
        "procurados"
      ],
      "description": "M\u00f3dulo do checkpoint que gerou o log"
    }
  },
  "required": [
    "timestamp",
    "classification"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "agent"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}