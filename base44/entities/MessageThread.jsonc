{
  "name": "MessageThread",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do grupo ou DM"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "group"
      ],
      "default": "direct"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos participantes"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "participant_ids"
  ]
}