{
  "name": "Agentes_Seguranca",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do agente de seguran\u00e7a"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "policial",
        "socorrista",
        "bombeiro"
      ],
      "description": "Tipo de agente de seguran\u00e7a"
    },
    "lat": {
      "type": "number",
      "description": "Latitude atual do agente (despacho geolocalizado)"
    },
    "lng": {
      "type": "number",
      "description": "Longitude atual do agente (despacho geolocalizado)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponivel",
        "em_atendimento",
        "fora_servico"
      ],
      "default": "disponivel",
      "description": "disponivel/em_atendimento = ativo; fora_servico = pausa/desativado"
    },
    "veiculo": {
      "type": "string",
      "description": "Viatura ou unidade (ex: PM-4521, SAMU-089)"
    },
    "push_token": {
      "type": "string",
      "description": "Token push do dispositivo do agente (FCM/APNs) para despacho em tempo real"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato do agente"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}