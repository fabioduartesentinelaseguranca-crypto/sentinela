{
  "name": "Agentes_Seguranca",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do agente de seguran\u00e7a"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "policial",
        "socorrista",
        "bombeiro"
      ],
      "description": "Tipo de agente de seguran\u00e7a"
    },
    "lat": {
      "type": "number",
      "description": "Latitude da base/localiza\u00e7\u00e3o"
    },
    "lng": {
      "type": "number",
      "description": "Longitude da base/localiza\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponivel",
        "em_atendimento",
        "fora_servico"
      ],
      "default": "disponivel"
    },
    "veiculo": {
      "type": "string",
      "description": "Viatura ou unidade (ex: PM-4521, SAMU-089)"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "agent"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}